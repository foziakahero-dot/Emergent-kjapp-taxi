  "components": {
    "schemas": {
      "DriverAction": {
        "properties": {
          "version": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "suspended"
            ],
            "title": "Action"
          },
          "reason": {
            "title": "Reason",
            "type": "string",
            "maxLength": 2000,
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "action"
        ],
        "title": "DriverAction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
