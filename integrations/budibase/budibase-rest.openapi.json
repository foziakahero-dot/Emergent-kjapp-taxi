            "minimum": 0.0,
            "title": "Base Fare"
          },
          "per_km": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Per Km"
          },
          "per_minute": {
            "type": "integer",
