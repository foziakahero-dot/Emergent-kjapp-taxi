# KJAPP backend environment example
APP_ENV=production
MONGO_URL=mongodb://...
DB_NAME=kjapp
JWT_SECRET=replace-with-strong-32-plus-character-secret

# Driver invitation links MUST point to the Fleet web app that owns /driver-signup/:token
KJAPP_PUBLIC_URL=https://fleet.kjappapp.no

# Native push (Firebase Cloud Messaging v1)
# FCM_PROJECT_ID must match BOTH Android apps' google-services.json project_id.
FCM_PROJECT_ID=your-firebase-project-id
# Use exactly one of these on the backend deployment:
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# Mobile app public backend URL is set through EAS/Expo env:
# EXPO_PUBLIC_BACKEND_URL=https://github-app-builder-28.emergent.host
