# KJAPP backend environment template
# Copy values into the deployment environment. Never commit real secrets.

# Runtime
APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=kjapp
JWT_SECRET=replace-with-a-long-random-secret
TRUST_PROXY=false
ENABLE_DEMO_DATA=false

# Public KJAPP URLs
FRONTEND_URL=https://kjappapp.no
KJAPP_PUBLIC_WEB_ORIGIN=https://kjappapp.no
KJAPP_CHECKOUT_ALLOWED_ORIGINS=https://kjappapp.no
PASSWORD_RESET_WEB_BASE=https://kjappapp.no

# Oslo closed-beta operating area
KJAPP_SERVICE_AREA_ENFORCE=false
KJAPP_SERVICE_AREA_CENTER_LAT=59.9139
KJAPP_SERVICE_AREA_CENTER_LNG=10.7522
KJAPP_SERVICE_AREA_RADIUS_KM=45

# Dispatch / GPS safety
DISPATCH_OFFER_SECONDS=20
KJAPP_PICKUP_ARRIVAL_RADIUS_M=400
KJAPP_DROPOFF_ARRIVAL_RADIUS_M=800
KJAPP_NO_SHOW_WAIT_MINUTES=5
KJAPP_DRIVER_ETA_REFRESH_SECONDS=20

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KJAPP_AUTO_CHARGE_ENABLED=false
VIPPS_CLIENT_ID=

# Email / password reset / receipts
SENDGRID_API_KEY=
SENDER_EMAIL=
# e.g. KJAPP <no-reply@kjappapp.no>

# Apple native Customer login
APPLE_BUNDLE_ID=no.kjapp.app
# Optional Services ID for web Apple OAuth:
APPLE_CLIENT_ID=

# Google auth
# The current beta client may still use the legacy Emergent session path.
# These are for the KJAPP-owned Google PKCE flow documented in BACKEND_MIGRATION_PLAN.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps / geocoding
MAPTILER_API_KEY=

# Push
# New Customer/Driver builds use Expo Push tokens, so direct FCM is legacy/optional here.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# Emergent-coupled integrations used until the post-beta ownership migration
EMERGENT_LLM_KEY=
INTEGRATION_PROXY_URL=

# Bootstrap/admin only. Prefer creating/rotating administrators through controlled operations.
ADMIN_EMAIL=
ADMIN_PASSWORD=
