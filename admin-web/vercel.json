{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/reset-password/:token",
      "destination": "https://fleet.kjappapp.no/reset-password/:token",
      "permanent": false
    },
    {
      "source": "/forgot-password",
      "destination": "https://fleet.kjappapp.no/glemt-passord",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://github-app-builder-28.emergent.host/api/:path*"
    }
  ]
}
