{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/reset-password/:token",
      "destination": "https://fleet.snarapp.no/reset-password/:token",
      "permanent": false
    },
    {
      "source": "/forgot-password",
      "destination": "https://fleet.snarapp.no/glemt-passord",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/gateway?__snar_path=:path*"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
