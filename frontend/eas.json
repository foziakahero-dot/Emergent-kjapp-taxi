{
  "build": {
    "apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    },
    "driver-diagnostic": {
      "distribution": "internal",
      "config": "driver-diagnostic.yml",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true,
        "image": "latest",
        "applicationArchivePath": "../driver-app/android/app/build/outputs/apk/release/app-release.apk"
      }
    }
  }
}
