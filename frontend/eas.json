{
  "build": {
    "apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kjappapp.no"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "autoIncrement": true
    },
    "ios-simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    },
    "testflight-beta": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "ios": {
        "image": "latest"
      }
    }
  },
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815866825"
      }
    },
    "testflight-beta": {
      "ios": {
        "ascAppId": "6815866825"
      }
    }
  }
}
