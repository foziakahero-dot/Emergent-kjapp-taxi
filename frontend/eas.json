{
  "build": {
    "apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host",
        "KJAPP_REQUIRE_FIREBASE": "true"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "environment": "preview"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host",
        "KJAPP_REQUIRE_FIREBASE": "true",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "environment": "production"
    },
    "ios-simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "environment": "development"
    }
  }
}
