{
  "build": {
    "apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kjappapp.no"
      },
      "android": {
        "buildType": "apk",
        "image": "latest",
        "resourceClass": "medium"
      },
      "environment": "production",
      "channel": "production"
    },
    "qa": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api-qa.snarapp.no",
        "KJAPP_REQUIRE_FIREBASE": "true"
      },
      "android": {
        "buildType": "apk",
        "image": "latest",
        "resourceClass": "medium"
      },
      "environment": "preview",
      "channel": "qa"
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kjappapp.no"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      },
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "ios-simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kjappapp.no"
      },
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "channel": "production",
      "environment": "production"
    },
    "testflight-beta": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kjappapp.no"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "medium"
      },
      "environment": "production",
      "channel": "production"
    },
    "testflight-qa": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api-qa.snarapp.no",
        "KJAPP_REQUIRE_FIREBASE": "true"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "medium"
      },
      "environment": "preview",
      "channel": "qa"
    }
  },
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815866825"
      }
    },
    "testflight-beta": {
      "ios": {
        "ascAppId": "6815866825"
      }
    },
    "testflight-qa": {
      "ios": {
        "ascAppId": "6815866825"
      }
    }
  }
}
