{
  "expo": {
    "name": "SNAR",
    "slug": "kjapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kjapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "no.nexorahub.kjapp.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vis biler i nærheten og hent deg der du er",
        "NSMicrophoneUsageDescription": "Bruk stemmen for å snakke med SNAR Assist og bestille taxi.",
        "ITSAppUsesNonExemptEncryption": false,
        "MGLMapboxMetricsEnabledSettingShownInApp": true,
        "NSCameraUsageDescription": "Ta et profilbilde eller skann betalingskort i SNAR."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "no.kjapp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FF0000"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.31.1"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vis biler i nærheten og hent deg der du er"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "kjapp_trips",
          "color": "#FF0000"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bruk stemmen for å snakke med SNAR Assist og bestille taxi.",
          "recordAudioAndroid": true
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 104,
          "backgroundColor": "#F4F6FA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Velg et profilbilde i SNAR.",
          "cameraPermission": "Ta et profilbilde i SNAR."
        }
      ]
    ],
    "extra": {
      "appRole": "customer",
      "eas": {
        "projectId": "3631002e-5b25-4847-b5d8-05ec2ef304b5"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
