# Public runtime values compiled into the Customer app. OAuth client IDs are public identifiers, not secrets.
EXPO_PUBLIC_BACKEND_URL=https://api.kjappapp.no

# Google OAuth client ID of type WEB. Required to obtain an ID token whose audience the backend verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth client ID of type iOS. Required for iOS native Google Sign-In.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Build-time reversed iOS client ID, e.g. com.googleusercontent.apps.123-abc.
# Used only by Expo app.config.js/config plugin. Not a secret.
GOOGLE_IOS_URL_SCHEME=
