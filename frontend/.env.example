# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app;
# they are visible to anyone who inspects the APK, so never put secret keys here.

# Backend API. Production: https://api.kjappapp.no  QA: https://api-qa.snarapp.no
EXPO_PUBLIC_BACKEND_URL=https://api-qa.snarapp.no

# Public Mapbox token (pk.*). Without it the app renders the raster fallback map and
# shows "Viser reservekart. Mapbox mangler konfigurasjon."
# For EAS builds set this as an EAS environment variable on the preview/production
# environments; for the GitHub Actions QA APK set it as a repository secret.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
