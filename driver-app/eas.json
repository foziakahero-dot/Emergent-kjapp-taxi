{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host",
        "KJAPP_REQUIRE_FIREBASE": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host",
        "KJAPP_REQUIRE_FIREBASE": "true",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      },
      "environment": "production"
    },
    "ios-simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "ios": {
        "simulator": true
      },
      "environment": "development"
    }
  }
}
