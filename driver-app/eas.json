{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host",
        "KJAPP_REQUIRE_FIREBASE": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kjappapp.no",
        "KJAPP_REQUIRE_FIREBASE": "true"
      },
      "ios": {
        "image": "latest"
      },
      "environment": "production"
    },
    "ios-simulator": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://github-app-builder-28.emergent.host"
      },
      "ios": {
        "simulator": true
      }
    },
    "testflight-beta": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.kjappapp.no"
      },
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "KUPTFG8BZ2",
        "ascAppId": "6815872647"
      }
    },
    "testflight-beta": {
      "ios": {
        "appleTeamId": "KUPTFG8BZ2",
        "ascAppId": "6815872647"
      }
    }
  }
}
