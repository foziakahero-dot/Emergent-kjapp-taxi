{
  "expo": {
    "name": "SNAR Driver",
    "slug": "kjapp-driver",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kjapp-driver",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "no.nexorahub.kjapp.driver",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "waze",
          "comgooglemaps",
          "maps"
        ],
        "NSLocationWhenInUseUsageDescription": "SNAR Driver bruker posisjonen din for å finne og gjennomføre turer.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SNAR Driver bruker posisjonen din under aktive skift og turer.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SNAR Driver bruker kameraet for å ta en selfie til identitetskontroll.",
        "MGLMapboxMetricsEnabledSettingShownInApp": true
      }
    },
    "android": {
      "package": "no.kjapp.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#001F3F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.31.1"
        }
      ],
      "./plugins/withNavigationQueries",
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SNAR Driver bruker posisjonen din for å finne turer i nærheten.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "kjapp_trips",
          "color": "#FF0000",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "SNAR Driver bruker kameraet for å ta en selfie til identitetskontroll.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/snar-splash-mark.png",
          "imageWidth": 96,
          "backgroundColor": "#08131F",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/snar-splash-mark.png",
            "backgroundColor": "#08131F"
          }
        }
      ]
    ],
    "extra": {
      "appRole": "driver",
      "eas": {
        "projectId": "1dec8949-0423-4fbf-a080-0703f93519d7"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/1dec8949-0423-4fbf-a080-0703f93519d7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true
    }
  }
}
