{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix ../admin-web install",
  "buildCommand": "npm --prefix ../admin-web run build && rm -rf dist && cp -R ../admin-web/dist dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.kjappapp.no/api/:path*"
    }
  ]
}
